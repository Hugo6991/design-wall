<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.designwall.x-shots</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/.design-wall/venv/bin/python3</string>
    <string>/Users/YOUR_USER/.design-wall/x_shots.py</string>
    <string>--limit</string><string>300</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/YOUR_USER/.design-wall/shots.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USER/.design-wall/shots.err</string>
</dict>
</plist>
