{
    "name": "design-wall",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/in/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "design-wall-db", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "design-wall-media" }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/2 * * * *"] },
  "vars": { "INTAKE_MODEL": "@cf/zai-org/glm-5.3-flash", "X_LIKES_SHEET_ID": "YOUR_SHEET_ID" }
}
